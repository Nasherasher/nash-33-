        "index.html",
        brand=BRAND,
        tagline=TAGLINE,
        menu=MENU,
        gallery=GALLERY,
        hours=HOURS,
        year=datetime.now().year,
    )


@app.post("/reservar")
def reservar():
    fields = ("nombre", "contacto", "fecha", "hora", "personas", "notas")
    form = {k: (request.form.get(k) or "").strip() for k in fields}

    missing = [k for k in ("nombre", "contacto", "fecha", "hora", "personas") if not form[k]]
    if missing:
        flash("Faltan datos: completa todos los campos obligatorios.", "error")
        return redirect(url_for("index") + "#reservar")

    try:
        personas = int(form["personas"])
        if not 1 <= personas <= 30:
            raise ValueError
    except ValueError:
        flash("El número de personas debe estar entre 1 y 30.", "error")
        return redirect(url_for("index") + "#reservar")

    save_reservation(form)
    flash(f"¡Gracias, {form['nombre'].split()[0]}! Recibimos tu solicitud para {personas} "
          f"persona(s) el {form['fecha']} a las {form['hora']}. Te confirmamos por teléfono.",
          "success")
    return redirect(url_for("index") + "#reservar")


