# --------------------------------------------------------------------------- #
# Helpers
# --------------------------------------------------------------------------- #
def save_reservation(payload: dict) -> None:
    """Append a reservation to a JSON Lines file."""
    os.makedirs(os.path.dirname(RESERVATIONS_FILE), exist_ok=True)
    record = {"created_at": datetime.utcnow().isoformat(timespec="seconds") + "Z", **payload}
    with open(RESERVATIONS_FILE, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(record, ensure_ascii=False) + "\n")


